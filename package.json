{
  "name": "cc-usage-collector",
  "version": "0.4.0",
  "private": true,
  "description": "Claude Code and Codex usage collector with metadata-only uploads and local session context recovery.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash install.sh",
    "collect": "pnpm --filter @cc-usage/collector start",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "node --test \"tests/*.test.mjs\" && pnpm -r test"
  },
  "packageManager": "pnpm@10.30.3"
}
